LIBRARY IEEE;
USE IEEE.STD_LOGIC_1164.ALL;
USE IEEE.STD_LOGIC_UNSIGNED.ALL;

ENTITY FD IS
	PORT( CLK, EN : IN STD_LOGIC;
			CLK_400, CLK_20: OUT STD_LOGIC
			);
END FD;

ARCHITECTURE BHV OF FD IS
	SIGNAL Q1 : STD_LOGIC ;
	SIGNAL Q2 : STD_LOGIC ;
BEGIN
PROCESS(CLK, EN)
	VARIABLE TEMP1 : INTEGER RANGE 0 TO 39;
	VARIABLE TEMP2 : INTEGER RANGE 0 TO 1;
BEGIN
IF CLK'EVENT AND CLK = '1' THEN
	IF EN = '1' THEN
		IF TEMP1 < 19 THEN
			TEMP1 := TEMP1 + 1;
			Q1 <= '0';
		ELSIF TEMP1 < 39 THEN
			TEMP1 := TEMP1 + 1;
			Q1 <= '1';
		ELSE
			TEMP1 := 0;
			Q1 <= '1';
		END IF;
		IF TEMP2 < 1 THEN
			TEMP2 := TEMP2 + 1;
			Q2 <= '0';
		ELSE
			TEMP2 := 0;
			Q2 <= '1';
		END IF;
	ELSE
		Q1 <= '0';
		Q2 <= '0';
	END IF;
END IF;

CLK_400 <= Q1;
CLK_20 <= Q2;
END PROCESS;

END BHV;